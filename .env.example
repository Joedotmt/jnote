# Copy to .env to point a local or self-hosted JNote at your own backend.
# Both are read at build time; a deployed build can also override them at runtime
# through window.JNOTE_CONFIG in src/app.html.

# PocketBase instance holding the jnote, jnote_content, and users collections.
VITE_POCKETBASE_URL=https://joemt.fly.dev

# Only used by deployments served from an origin the account bridge allows.
VITE_ACCOUNTS_ORIGIN=https://accounts.joe.mt
