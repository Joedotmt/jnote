{
	"name": "jnote",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"test": "node --test tests/*.test.js",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:backend": "node tests/backend.integration.mjs",
		"test:cutover": "node tests/cutover.integration.mjs",
		"backend:install": "node scripts/install-pocketbase.mjs",
		"benchmark:cache": "node scripts/benchmark-cache.mjs"
	},
	"dependencies": {
		"pocketbase": "^0.28.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"fake-indexeddb": "^6.2.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	}
}
